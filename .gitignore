# Third-party copyrighted journal PDFs -- cited by DOI in the methodology,
# not redistributed from this public repo.
*.pdf

# CINELDI dataset: keep only the 50-bus rural grid actually used
# (src/case_data.py DEFAULT_GRID); the other three grid variants and the raw
# zip in the same Zenodo release aren't read by any code here.
data/raw/dataset.zip
data/raw/cineldi_lv/dataset/39_bus_semi_urban_reference_grid/
data/raw/cineldi_lv/dataset/56_bus_semi_urban_reference_grid/
data/raw/cineldi_lv/dataset/80_bus_rural_reference_grid/

# Run logs and superseded/pilot result files. The authoritative dataset is
# results/pricing_mechanisms_fullyear.csv.
results/*.log
results/monthly_hourly.csv
results/monthly_hourly_skipped.txt
results/monthly_hourly_pilot.csv
results/monthly_hourly_pilot_skipped.txt
results/monthly_hourly_waterval_pilot.csv

# Keep only the authoritative full-year result and compact validation outputs.
results/*.csv
!results/pricing_mechanisms_fullyear.csv
!results/local_optimum_check.csv
!results/multistart_check.csv
!results/piq_sensitivity.csv
results/*.txt

# Keep only figures used to document or present the final study.
results/figures/*.png
!results/figures/fig0_demand_data.png
!results/figures/fig1_capability.png
!results/figures/network_diagram.png
!results/figures/fig_dispatch_by_machine.png
